{
  "name": "baseball-explorer-web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js frontend for Baseball Explorer (WEB-M1: shell, Home, Historical Explorer, Leaderboards on fixture data).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run api:types:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "api:schema": "node scripts/fetch-openapi.mjs",
    "api:types": "openapi-typescript openapi/baseball-api.json -o src/lib/api/generated/baseball-api.ts --immutable",
    "api:types:check": "openapi-typescript openapi/baseball-api.json -o src/lib/api/generated/baseball-api.ts --immutable --check",
    "test:live": "vitest run --config vitest.live.config.mts",
    "api:record": "node scripts/record-api-responses.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
