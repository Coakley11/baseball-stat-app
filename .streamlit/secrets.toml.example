# Copy to secrets.toml locally (gitignored) or paste into Streamlit Cloud → Settings → Secrets
# Use the same block on EVERY suite app deployment (Command Center + Music + Baseball + …).

[suite_activity]
supabase_url = "https://YOUR_PROJECT.supabase.co"
supabase_key = "YOUR_SERVICE_ROLE_KEY"
# Public anon key — required for Real Accounts login (Supabase → Settings → API → anon public)
supabase_anon_key = "YOUR_ANON_PUBLIC_KEY"
# Identical suite_user_id on every app + device (phone and laptop share memory)
suite_user_id = "daniel"
suite_user_email = "you@example.com"
# Enable Supabase email/password accounts for Baseball.
suite_auth_enabled = true
# Optional Free-plan Supabase egress throttle.
suite_low_egress = "1"

# Baseball billing client: public values only. Stripe and Supabase elevated keys
# belong on the separately deployed baseball_billing_service, never in this block.
[baseball_billing]
rollout = "test"
stripe_mode = "test"
service_url = "https://YOUR_BILLING_SERVICE"
public_base_url = "https://YOUR_BASEBALL_STREAMLIT_APP"
